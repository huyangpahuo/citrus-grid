---
import '@/styles/ProfileCard.css'
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import {
  mdiClockOutline,
  mdiDevTo,
  mdiEmailOutline,
  mdiFacebook,
  mdiGithub,
  mdiInstagram,
  mdiLinkedin,
  mdiLinkVariant,
  mdiRss,
  mdiTwitter,
  mdiWeb,
  mdiYoutube,
} from '@/lib/icons'
import { getPublishedPosts, readMinutes, totalWords } from '@/lib/posts'
import { siteConfig } from '@/site.config'

interface Props {
  lang?: Lang
}

interface Social {
  platform: string
  url: string
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

const posts = await getPublishedPosts()

const words = totalWords(posts)
const minutes = posts.reduce((sum, p) => sum + readMinutes(p), 0)
const hours = minutes > 0 ? Math.round((minutes / 60) * 10) / 10 : 0
const articles = posts.length

const statsEnabled = Boolean(siteConfig.statsScript)

const numberLocale = { zh: 'zh-CN', ja: 'ja-JP', en: 'en-US' }[lang]

const platformIcons: Record<string, string> = {
  github: mdiGithub,
  twitter: mdiTwitter,
  x: mdiTwitter,
  linkedin: mdiLinkedin,
  youtube: mdiYoutube,
  instagram: mdiInstagram,
  facebook: mdiFacebook,
  devto: mdiDevTo,
  rss: mdiRss,
  email: mdiEmailOutline,
  mail: mdiEmailOutline,
  website: mdiWeb,
  blog: mdiWeb,
}

const platformBrands: Record<string, string> = {
  github: '#24292e',
  twitter: '#1da1f2',
  x: '#1da1f2',
  linkedin: '#0a66c2',
  youtube: '#ff0000',
  instagram: '#e4405f',
  facebook: '#1877f2',
  devto: '#0a0a0a',
  medium: '#000000',
  rss: '#f26522',
}

const socials = ((siteConfig.socials as Social[] | undefined) ?? []).map((s) => {
  const key = (s.platform || '').toLowerCase()
  return {
    ...s,
    key,
    icon: platformIcons[key] ?? mdiLinkVariant,
    brand: platformBrands[key] ?? 'var(--wp-accent)',
    label: s.platform ? s.platform.charAt(0).toUpperCase() + s.platform.slice(1) : 'Link',
  }
})

const isExternal = (url: string) => /^(https?:|mailto:)/.test(url)

const segments = ['a', 'b', 'c', 'd', 'e', 'f', 'g']
const clockSlots = ['h1', 'h2', ':', 'm1', 'm2', ':', 's1', 's2']
---

<div class="profile-card mx-auto max-w-[800px] pb-4">
  <div class="card">
    <div class="card-preview" data-card-preview aria-hidden="true"></div>
    <div class="row-top">
      <div class="user-area">
        <img class="avatar" src={siteConfig.avatar} alt={siteConfig.author} width="64" height="64" />
        <div class="user-meta">
          <div class="username">
            {siteConfig.author}
          </div>
          <span class="bio">{siteConfig.description}</span>
        </div>
      </div>

      <div class="stats">
        <div class="stat-item">
          <span class="stat-number">
            {words.toLocaleString(numberLocale)}<span class="unit">{t('profile.wordsUnit')}</span>
          </span>
          <span class="stat-label">{t('profile.wordsLabel')}</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">
            {hours.toLocaleString(numberLocale)}<span class="unit">{t('profile.hoursUnit')}</span>
          </span>
          <span class="stat-label">{t('profile.hoursLabel')}</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">
            {articles.toLocaleString(numberLocale)}<span class="unit">{t('profile.articlesUnit')}</span>
          </span>
          <span class="stat-label">{t('profile.articlesLabel')}</span>
        </div>
        {statsEnabled && (
          <div class="stats-extra">
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-number">
                <span data-stats="site-uv" class="stat-live">-</span><span class="unit">{t('profile.uvUnit')}</span>
              </span>
              <span class="stat-label">{t('profile.uvLabel')}</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-number">
                <span data-stats="site-pv" class="stat-live">-</span><span class="unit">{t('profile.pvUnit')}</span>
              </span>
              <span class="stat-label">{t('profile.pvLabel')}</span>
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="clock-layer" data-clock-layer data-locale={numberLocale} aria-hidden="true">
      <span class="clock-tz" data-clock-tz></span>
      <div class="clock-time">
        {
          clockSlots.map((slot) =>
            slot === ':' ? (
              <span class="clock-colon">
                <i></i>
                <i></i>
              </span>
            ) : (
              <span class="seg-digit">
                {segments.map((seg) => (
                  <i data-seg={seg}></i>
                ))}
              </span>
            ),
          )
        }
      </div>
      <span class="clock-date" data-clock-date></span>
    </div>
  </div>

  <div class="social-strip">
    <button
      type="button"
      class="card-toggle"
      data-clock-toggle
      aria-pressed="false"
      aria-label={t('profile.showClock')}
      title={t('profile.showClock')}
      data-label-clock={t('profile.showClock')}
      data-label-profile={t('profile.showProfile')}
    >
      <Icon d={mdiClockOutline} />
    </button>
    {socials.map((s) => (
      <a
        href={s.url}
        class="social-btn"
        style={'--p-brand:' + s.brand}
        aria-label={s.label}
        title={s.label}
        target={isExternal(s.url) && !s.url.startsWith('mailto:') ? '_blank' : undefined}
        rel={isExternal(s.url) && !s.url.startsWith('mailto:') ? 'noopener noreferrer' : undefined}
      >
        <Icon d={s.icon} />
      </a>
    ))}
  </div>
</div>

<script>
  import { iconSvg } from '@/lib/icons'

  const STRIP_W = 28
  const STAGGER = 25
  const STRIP_DUR = 480

  const DIGIT_SEGS: Record<string, string> = {
    0: 'abcdef',
    1: 'bc',
    2: 'abdeg',
    3: 'abcdg',
    4: 'bcfg',
    5: 'acdfg',
    6: 'acdefg',
    7: 'abc',
    8: 'abcdefg',
    9: 'abcdfg',
  }

  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v)
  const pad2 = (n: number) => String(n).padStart(2, '0')

  function initProfileCardClock() {
    const root = document.querySelector<HTMLElement>('.profile-card')
    const card = root?.querySelector<HTMLElement>('.card')
    const layer = card?.querySelector<HTMLElement>('[data-clock-layer]')
    const btn = root?.querySelector<HTMLButtonElement>('[data-clock-toggle]')
    const tzEl = layer?.querySelector<HTMLElement>('[data-clock-tz]')
    const dateEl = layer?.querySelector<HTMLElement>('[data-clock-date]')
    if (!card || !layer || !btn || !tzEl || !dateEl) return

    const digits = Array.from(layer.querySelectorAll<HTMLElement>('.seg-digit'))
    const locale = layer.dataset.locale || 'zh-CN'
    const dateFmt = new Intl.DateTimeFormat(locale, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      weekday: 'short',
    })

    let timer = 0
    let lastText = ''
    let lastTz = ''
    const painted: string[] = []

    const paintDigit = (el: HTMLElement, ch: string) => {
      const on = DIGIT_SEGS[ch] ?? ''
      for (const seg of el.querySelectorAll<HTMLElement>('i')) {
        seg.classList.toggle('on', on.includes(seg.dataset.seg || ''))
      }
    }

    const tzLabel = (now: Date) => {
      const iana = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Local'
      const offset = -now.getTimezoneOffset()
      const sign = offset < 0 ? '-' : '+'
      const abs = Math.abs(offset)
      const mins = abs % 60
      return `${iana} · UTC${sign}${Math.floor(abs / 60)}${mins ? `:${pad2(mins)}` : ''}`
    }

    const tick = () => {
      window.clearTimeout(timer)
      const now = new Date()
      const text = `${pad2(now.getHours())}${pad2(now.getMinutes())}${pad2(now.getSeconds())}`
      if (text !== lastText) {
        lastText = text
        for (let i = 0; i < digits.length; i++) {
          if (painted[i] !== text[i]) {
            painted[i] = text[i]
            paintDigit(digits[i], text[i])
          }
        }
        const date = dateFmt.format(now)
        if (dateEl.textContent !== date) dateEl.textContent = date
        const tz = tzLabel(now)
        if (tz !== lastTz) {
          lastTz = tz
          tzEl.textContent = tz
        }
      }
      timer = window.setTimeout(tick, 1000 - (Date.now() % 1000) + 20)
    }
    tick()
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) tick()
    })

    function polygonAt(count: number, w: number, h: number, progress: number[]) {
      const pts = [`0px 0px`, `${w}px 0px`]
      for (let i = count - 1; i >= 0; i--) {
        const y = h * progress[i]
        pts.push(`${(w * (i + 1)) / count}px ${y}px`, `${(w * i) / count}px ${y}px`)
      }
      return `polygon(${pts.join(', ')})`
    }

    function buildFrames(count: number, w: number, h: number, reverse: boolean) {
      const total = STRIP_DUR + (count - 1) * STAGGER
      const times = new Set<number>([0, total])
      for (let i = 0; i < count; i++) {
        times.add(Math.min(total, i * STAGGER))
        times.add(Math.min(total, i * STAGGER + STRIP_DUR))
      }
      const frames = Array.from(times)
        .sort((a, b) => a - b)
        .map((t) => ({
          offset: t / total,
          clipPath: polygonAt(
            count,
            w,
            h,
            Array.from({ length: count }, (_, i) => clamp01((t - i * STAGGER) / STRIP_DUR)),
          ),
        }))
      return reverse
        ? frames
            .slice()
            .reverse()
            .map((f) => ({ offset: 1 - f.offset, clipPath: f.clipPath }))
        : frames
    }

    let clockShown = false
    let anim: Animation | null = null

    const syncButton = () => {
      const label = (clockShown ? btn.dataset.labelProfile : btn.dataset.labelClock) || ''
      btn.setAttribute('aria-pressed', String(clockShown))
      btn.setAttribute('aria-label', label)
      btn.setAttribute('title', label)
      btn.innerHTML = iconSvg(clockShown ? 'mdi-account-outline' : 'mdi-clock-outline')
    }

    btn.addEventListener('click', () => {
      if (anim) return
      clockShown = !clockShown
      syncButton()
      if (!clockShown) card.classList.remove('is-clock')

      const settle = () => {
        layer.classList.toggle('is-on', clockShown)
        card.classList.toggle('is-clock', clockShown)
      }
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        settle()
        return
      }
      const w = layer.offsetWidth
      const h = layer.offsetHeight
      const count = Math.max(1, Math.round(w / STRIP_W))
      const frames = buildFrames(count, w, h, !clockShown)
      const options = { duration: STRIP_DUR + (count - 1) * STAGGER, fill: 'both' as const }
      const running = layer.animate(frames, options)
      const mirrored = [...card.querySelectorAll<HTMLElement>('.clock-layer')]
        .filter((el) => el !== layer)
        .map((el) => el.animate(frames, options))
      anim = running
      running.onfinish = () => {
        settle()
        running.cancel()
        for (const m of mirrored) m.cancel()
        card.dispatchEvent(new CustomEvent('profile-card-clock-settle'))
        anim = null
      }
    })
  }

  function initProfileCardPreview() {
    const card = document.querySelector<HTMLElement>('.profile-card .card')
    const preview = card?.querySelector<HTMLElement>('[data-card-preview]')
    if (!card || !preview) return

    const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    const textSel = '.stat-live, .clock-tz, .clock-date'
    const classSel = '.seg-digit i, .clock-layer, .stats'
    let frame = 0
    let syncTimer = 0
    let active = false
    let pointerX = 0
    let pointerY = 0
    let originLeft = 0
    let originTop = 0
    let clone: HTMLElement | null = null

    preview.inert = true

    const build = () => {
      const dark = document.documentElement.classList.contains('dark')
      const next = card.cloneNode(true) as HTMLElement
      for (const node of next.querySelectorAll('[data-card-preview]')) node.remove()
      for (const node of next.querySelectorAll('[data-stats], [data-clock-toggle], [data-clock-layer]')) {
        for (const name of [
          'data-stats',
          'data-clock-toggle',
          'data-clock-layer',
          'data-clock-tz',
          'data-clock-date',
          'data-locale',
          'data-label-clock',
          'data-label-profile',
        ]) {
          node.removeAttribute(name)
        }
      }
      next.classList.add('card-preview-clone')
      next.classList.add(dark ? 'light' : 'dark')
      next.setAttribute('aria-hidden', 'true')
      preview.replaceChildren(next)
      clone = next
    }

    const measure = () => {
      const rect = preview.getBoundingClientRect()
      originLeft = rect.left
      originTop = rect.top
    }

    const render = () => {
      preview.style.setProperty('--preview-x', `${pointerX - originLeft}px`)
      preview.style.setProperty('--preview-y', `${pointerY - originTop}px`)
    }

    const reset = () => {
      active = false
      preview.classList.remove('is-on')
      window.clearInterval(syncTimer)
      syncTimer = 0
    }

    const sync = () => {
      const root = clone
      if (!root) return
      const dark = document.documentElement.classList.contains('dark')
      const wantClass = card.className + ' card-preview-clone ' + (dark ? 'light' : 'dark')
      if (root.className !== wantClass) root.className = wantClass

      const srcOf = (sel: string) => [...card.querySelectorAll(sel)].filter((el) => !preview.contains(el))

      const sText = srcOf(textSel)
      const dText = root.querySelectorAll(textSel)
      if (sText.length === dText.length) {
        for (let i = 0; i < sText.length; i++) {
          if (dText[i].textContent !== sText[i].textContent) dText[i].textContent = sText[i].textContent
        }
      }
      const sCls = srcOf(classSel)
      const dCls = root.querySelectorAll(classSel)
      if (sCls.length === dCls.length) {
        for (let i = 0; i < sCls.length; i++) {
          if (dCls[i].className !== sCls[i].className) dCls[i].className = sCls[i].className
        }
      }
    }

    const move = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || reduceQuery.matches) return
      pointerX = e.clientX
      pointerY = e.clientY
      if (!active) {
        active = true
        measure()
        sync()
        render()
        preview.classList.add('is-on')
        window.clearInterval(syncTimer)
        syncTimer = window.setInterval(() => {
          if (active) sync()
        }, 250)
        return
      }
      if (!frame) {
        frame = requestAnimationFrame(() => {
          frame = 0
          if (!active) return
          render()
          sync()
        })
      }
    }

    const leave = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return
      reset()
    }

    const refresh = () => {
      if (!active) return
      if (!preview.isConnected || !preview.offsetWidth) {
        reset()
        return
      }
      measure()
      render()
    }

    build()
    card.addEventListener('pointermove', move, { passive: true })
    card.addEventListener('pointerleave', leave)
    window.addEventListener('scroll', refresh, { passive: true })
    window.addEventListener('resize', refresh)
    document.addEventListener('theme-change', () => {
      if (!active) return
      sync()
      render()
    })
    card.addEventListener('profile-card-clock-settle', () => {
      if (active) sync()
    })
  }

  initProfileCardClock()
  initProfileCardPreview()
</script>

